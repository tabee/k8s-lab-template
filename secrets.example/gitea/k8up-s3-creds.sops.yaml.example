# Template for k8up-s3-creds.sops.yaml: structure without real values.
# lab.sh init fills the placeholders from files on your machine and encrypts immediately
# to secrets/gitea/k8up-s3-creds.sops.yaml. Placeholders: @file:NAME, @env:NAME:KEY, @ca:NAME:KEY
# (NAME = entry in ansible/inventory/group_vars/all/secrets.yml).
# A value without @ is fixed text.
apiVersion: v1
kind: Secret
metadata:
  name: k8up-s3-creds
  namespace: gitea
  labels:
    app.kubernetes.io/managed-by: argocd
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
type: Opaque
stringData:
  ACCESS_KEY_ID: "@env:s3-k8up:ACCESS_KEY_ID"
  ACCESS_SECRET_KEY: "@env:s3-k8up:ACCESS_SECRET_KEY"
