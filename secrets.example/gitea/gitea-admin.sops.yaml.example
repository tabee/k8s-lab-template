# Template for gitea-admin.sops.yaml: structure without real values.
# lab.sh init fills the placeholders from files on your machine and encrypts immediately
# to secrets/gitea/gitea-admin.sops.yaml. Placeholders: @file:NAME, @env:NAME:KEY, @ca:NAME:KEY
# (NAME = entry in ansible/inventory/group_vars/all/secrets.yml).
# A value without @ is fixed text.
apiVersion: v1
kind: Secret
metadata:
  name: gitea-admin
  namespace: gitea
  labels:
    app.kubernetes.io/managed-by: argocd
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
type: Opaque
stringData:
  username: "@file:gitea-admin-user"
  password: "@file:gitea-admin-pw"
