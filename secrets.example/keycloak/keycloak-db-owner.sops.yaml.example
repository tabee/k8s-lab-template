# Template for keycloak-db-owner.sops.yaml: structure without real values.
# lab.sh init fills the password and encrypts immediately.
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-db-owner
  namespace: keycloak
  labels:
    app.kubernetes.io/managed-by: argocd
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
type: kubernetes.io/basic-auth
stringData:
  username: "keycloak"
  password: "@file:keycloak-db-pw"
