# {{ ansible_managed }}
# API audit: who changed what and when. First matching rule wins.
# Never log secrets/configmaps/tokens with content (metadata only), otherwise they end up
# as plaintext secrets in the log.
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - RequestReceived
omitManagedFields: true
rules:
  # Noise: health checks and metrics
  - level: None
    nonResourceURLs:
      - /healthz*
      - /readyz*
      - /livez*
      - /version
      - /metrics
  # Noise: leader election and node heartbeats (every 10 s)
  - level: None
    verbs: ["get", "update", "watch"]
    resources:
      - group: coordination.k8s.io
        resources: ["leases"]
  - level: None
    userGroups: ["system:nodes"]
    verbs: ["get", "watch", "patch"]
    resources:
      - group: ""
        resources: ["nodes", "nodes/status"]
  - level: None
    users: ["system:kube-proxy"]
    verbs: ["watch"]
    resources:
      - group: ""
        resources: ["endpoints", "services", "services/status"]
      - group: discovery.k8s.io
        resources: ["endpointslices"]
  - level: None
    resources:
      - group: ""
        resources: ["events"]
      - group: events.k8s.io
        resources: ["events"]
  # Sensitive objects: never request/response body
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps", "serviceaccounts/token"]
      - group: authentication.k8s.io
        resources: ["tokenreviews"]
  # Reading: metadata only
  - level: Metadata
    verbs: ["get", "list", "watch"]
  # Writing: with request body (who changed what)
  - level: Request
    verbs: ["create", "update", "patch", "delete", "deletecollection"]
  # Rest (z.B. exec/attach/proxy): metadata
  - level: Metadata
